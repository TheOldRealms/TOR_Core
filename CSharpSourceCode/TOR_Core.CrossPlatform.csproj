<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Library</OutputType>
    <RootNamespace>TOR_Core</RootNamespace>
    <AssemblyName>TOR_Core</AssemblyName>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Disable auto-generated AssemblyInfo (we have Properties/AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Output to mod's bin folder -->
    <OutputPath>..\bin\Win64_Shipping_Client\</OutputPath>
  </PropertyGroup>

  <!-- Import local configuration if exists (copy Local.props.template to Local.props) -->
  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <!-- Platform detection for Bannerlord path (must come before debug config) -->
  <PropertyGroup>
    <!-- Override with environment variable: BANNERLORD_PATH -->
    <BannerlordPath Condition="'$(BANNERLORD_PATH)' != ''">$(BANNERLORD_PATH)</BannerlordPath>

    <!-- Default Windows path (absolute, since relative with forward slashes fails) -->
    <BannerlordPath Condition="'$(BannerlordPath)' == '' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">$(MSBuildThisFileDirectory)..\..\..</BannerlordPath>

    <!-- Default Linux path (Steam Proton) - adjust as needed -->
    <BannerlordPath Condition="'$(BannerlordPath)' == '' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">$(HOME)/.steam/steam/steamapps/common/Mount &amp; Blade II Bannerlord</BannerlordPath>

    <!-- Fallback for older MSBuild -->
    <BannerlordPath Condition="'$(BannerlordPath)' == ''">$(MSBuildThisFileDirectory)..\..\..</BannerlordPath>

    <GameBinPath>$(BannerlordPath)\bin\Win64_Shipping_Client</GameBinPath>
    <ModulesPath>$(BannerlordPath)\Modules</ModulesPath>
  </PropertyGroup>

  <!-- Debug/Run configuration (F5 / green arrow) -->
  <PropertyGroup>
    <StartAction>Program</StartAction>
    <StartProgram>$(GameBinPath)\Bannerlord.exe</StartProgram>
    <StartArguments>/singleplayer _MODULES_*Native*SandBoxCore*SandBox*StoryMode*CustomBattle*TOR_Armory*TOR_Environment*TOR_Core*_MODULES_</StartArguments>
    <StartWorkingDirectory>$(GameBinPath)</StartWorkingDirectory>
  </PropertyGroup>

  <!-- Configuration-specific settings -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;_RGL_KEEP_ASSERTS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- CRITICAL: This enables building .NET Framework 4.8 on Linux! -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- .NET Framework assembly references (required for SDK-style projects) -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
