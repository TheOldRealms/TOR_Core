<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="40" Text="@HeaderText" Brush.FontSize="42" Brush.TextColor="#FFFFFFFF"/>

        <!-- Scene spot markers: one brown chip per ambush spot, positioned
             each tick from the controller's layout via screen-projected
             coordinates on the parent VM. Clicking is a follow-up slice. -->
        <ListPanel DataSource="{SpotMarkers}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
          <ItemTemplate>
            <BrushWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="52" HorizontalAlignment="Left" VerticalAlignment="Top" PositionXOffset="@ScreenX" PositionYOffset="@ScreenY" Brush="OrderOfBattle.FormationTypeSelection.Dropdown" IsVisible="@IsVisible">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" IntText="@Number" Brush.FontSize="28" Brush.TextColor="#F2D580FF"/>
              </Children>
            </BrushWidget>
          </ItemTemplate>
        </ListPanel>

      </Children>
    </Widget>
  </Window>
</Prefab>
