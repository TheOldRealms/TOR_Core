<Prefab>
  <!-- World-anchored labeled marker for the ambush extraction zone.
       Driven by AmbushRetreatZoneMarkerVM; the view projects the zone's
       world position each tick through MBWindowManager.WorldToScreen and
       writes the screen pixel coordinates as a single Vec2 on the VM.

       Click routes through ButtonWidget → Command.Click on the VM,
       which asks the PlayerOrderController to move the currently
       selected formations to the zone. Nested TextWidgets are
       DoNotAcceptEvents so their glyphs don't eat the click; see the
       bannerlord-textwidget-eats-clicks memory.

       Outer Widget stretches to layer bounds so the inner widget can
       place itself in screen pixels off the top-left origin. Inner
       stack uses CoverChildren sizing + Position="@ScreenPosition" to
       anchor at the projected screen point. DO NOT use
       HorizontalAlignment / VerticalAlignment + PositionXOffset here;
       those produce the HUD-corner-stuck bug the v1 marker had. -->
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsHidden="@_not@IsVisible">
      <Children>
        <ButtonWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                      Position="@ScreenPosition"
                      Command.Click="ExecuteMoveToExtraction">
          <Children>
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                       StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="36" SuggestedHeight="36"
                        HorizontalAlignment="Center"
                        Sprite="BlankWhiteCircle" Color="#FFD700FF" />
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Center"
                            Text="@LabelText"
                            Brush="NameMarker.Distance.Text"
                            DoNotAcceptEvents="true" />
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Center"
                            Text="@DistanceText"
                            Brush="NameMarker.Distance.Text"
                            DoNotAcceptEvents="true" />
              </Children>
            </ListPanel>
          </Children>
        </ButtonWidget>
      </Children>
    </Widget>
  </Window>
</Prefab>
