<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

          <!-- Standard Background -->


          <!-- Character Display on Left (using CharacterTableauWidget like SpellBook) -->
          <CharacterTableauWidget DataSource="{CurrentCharacter}"
                                  WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="550" SuggestedHeight="1000"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  MarginLeft="100"
                                  BannerCodeText="@BannerCodeText"
                                  BodyProperties="@BodyProperties"
                                  CharStringId="@CharStringId"
                                  EquipmentCode="@EquipmentCode"
                                  IsFemale="@IsFemale"
                                  MountCreationKey="@MountCreationKey"
                                  Race="@Race"
                                  StanceIndex="@StanceIndex"
                                  ArmorColor1="@ArmorColor1"
                                  ArmorColor2="@ArmorColor2"
                                  IsEnabled="false"
                                  DoNotUseCustomScale="true" />

          <!-- Main content panel - POSITIONED ON RIGHT to show character on left -->

        <!-- Main content panel - MOVED TO RIGHT to show character on left -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="900" SuggestedHeight="850"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                MarginRight="50"
                Sprite="StdAssets\Popup\canvas">
          <Children>

            <!-- Title -->
            <RichTextWidget Text="@TitleText"
                            WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                            SuggestedWidth="800"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            MarginTop="50"
                            Brush.FontSize="42"
                            Brush.TextHorizontalAlignment="Center"
                            Brush.Color="#FFFFFFFF" />

            <!-- Description -->
            <RichTextWidget Text="@DescriptionText"
                            WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                            SuggestedWidth="750"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            MarginTop="150"
                            Brush.FontSize="28"
                            Brush.TextHorizontalAlignment="Center"
                            Brush.Color="#FFFFFFFF" />

            <!-- Options List - Simplified to show only icon + name -->
            <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                       SuggestedWidth="800" SuggestedHeight="250"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       MarginTop="230"
                       DataSource="{Options}"
                       StackLayout.LayoutMethod="VerticalBottomToTop">
              <ItemTemplate>
                <ButtonWidget DoNotPassEventsToChildren="true"
                              Command.Click="ExecuteSelect"
                              WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="780" SuggestedHeight="80"
                              MarginBottom="8"
                              Sprite="StdAssets\Popup\buttonbase2">
                  <Children>

                    <!-- Icon -->
                    <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                 SuggestedWidth="80" SuggestedHeight="80"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 MarginLeft="10"
                                 Sprite="@IconSprite" />

                    <!-- Option name -->
                    <TextWidget DoNotAcceptEvents="true"
                                Text="@Name"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                MarginLeft="105"
                                Brush.FontSize="30"
                                Brush.TextVerticalAlignment="Center"
                                Brush.Color="#FFFFFFFF" />

                    <!-- Selection indicator (checkmark or border when selected) -->
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                            SuggestedWidth="40" SuggestedHeight="40"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            MarginRight="15"
                            Sprite="BlankWhiteSquare_9"
                            Color="#FFD700"
                            IsVisible="@IsSelected" />

                  </Children>
                </ButtonWidget>
              </ItemTemplate>
            </ListPanel>

            <!-- Detail Panel - Shows selected option details below selection window -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                    SuggestedWidth="800" SuggestedHeight="250"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    MarginTop="490"
                    IsVisible="@HasSelection">
              <Children>

                <!-- Description -->
                <TextWidget Text="@SelectedDescription"
                            WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                            SuggestedWidth="780"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MarginLeft="10" MarginTop="10"
                            Brush.FontSize="24"
                            Brush.TextHorizontalAlignment="Left"
                            Brush.Color="#FFFFFFFF" />

                <!-- Positive Effect -->
                <TextWidget Text="@SelectedPositiveEffect"
                            WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                            SuggestedWidth="780"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MarginLeft="10" MarginTop="100"
                            Brush.FontSize="22"
                            Brush.TextHorizontalAlignment="Left"
                            Brush.Color="#00FF00"
                            IsVisible="@HasPositiveEffect" />

                <!-- Negative Effect -->
                <TextWidget Text="@SelectedNegativeEffect"
                            WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                            SuggestedWidth="780"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MarginLeft="10" MarginTop="150"
                            Brush.FontSize="22"
                            Brush.TextHorizontalAlignment="Left"
                            Brush.Color="#FF0000"
                            IsVisible="@HasNegativeEffect" />

              </Children>
            </Widget>

            <!-- Button container -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                    SuggestedWidth="600" SuggestedHeight="80"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    MarginBottom="50">
              <Children>

                <!-- Back Button -->
                <ButtonWidget DoNotPassEventsToChildren="true"
                              Command.Click="OnPreviousStage"
                              WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="250" SuggestedHeight="60"
                              HorizontalAlignment="Left"
                              Sprite="StdAssets\Popup\buttonbase2">
                  <Children>
                    <TextWidget DoNotAcceptEvents="true"
                                Text="@NegativeText"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Brush.FontSize="28"
                                Brush.TextHorizontalAlignment="Center"
                                Brush.TextVerticalAlignment="Center"
                                Brush.Color="#FFFFFFFF" />
                  </Children>
                </ButtonWidget>

                <!-- Continue Button -->
                <ButtonWidget DoNotPassEventsToChildren="true"
                              Command.Click="OnNextStage"
                              IsEnabled="@CanAdvance"
                              WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="250" SuggestedHeight="60"
                              HorizontalAlignment="Right"
                              Sprite="StdAssets\Popup\buttonbase1">
                  <Children>
                    <TextWidget DoNotAcceptEvents="true"
                                Text="@AffirmativeText"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Brush.FontSize="28"
                                Brush.TextHorizontalAlignment="Center"
                                Brush.TextVerticalAlignment="Center"
                                Brush.Color="#FFFFFFFF" />
                  </Children>
                </ButtonWidget>

              </Children>
            </Widget>

          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
