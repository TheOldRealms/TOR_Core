<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

          <!-- Standard Background -->


          <!-- Character Display on Left (using CharacterTableauWidget like SpellBook) -->
          <CharacterTableauWidget DataSource="{CurrentCharacter}"
                                  WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="550" SuggestedHeight="1000"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  MarginLeft="100"
                                  BannerCodeText="@BannerCodeText"
                                  BodyProperties="@BodyProperties"
                                  CharStringId="@CharStringId"
                                  EquipmentCode="@EquipmentCode"
                                  IsFemale="@IsFemale"
                                  MountCreationKey="@MountCreationKey"
                                  Race="@Race"
                                  StanceIndex="@StanceIndex"
                                  ArmorColor1="@ArmorColor1"
                                  ArmorColor2="@ArmorColor2"
                                  IsEnabled="false"
                                  DoNotUseCustomScale="true" />

          <!-- Custom Gained Properties Display for Specialization -->
          <Widget DataSource="{GainedPropertiesController}"
                  WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  MarginLeft="20">
            <Children>
              <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" MarginLeft="20" StackLayout.LayoutMethod="VerticalBottomToTop">
                <Children>

                  <!-- Attributes List -->
                  <ListPanel DataSource="{Attributes}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalBottomToTop" MarginBottom="15">
                    <ItemTemplate>
                      <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginBottom="10">
                        <Children>
                          <!-- Positive Change (Green) -->
                          <TextWidget IsVisible="@IsPositive" Text="@NameText" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush.FontSize="28" Brush.FontColor="#99DC30FF" ClipContents="false">
                            <Children>
                              <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="12" SuggestedHeight="16" PositionXOffset="15" VerticalAlignment="Center" HorizontalAlignment="Right" Sprite="General\CharacterCreation\increasing_icon" Color="#99DC30FF" />
                            </Children>
                          </TextWidget>
                          <!-- Negative Change (Red) -->
                          <TextWidget IsVisible="@IsNegative" Text="@NameText" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush.FontSize="28" Brush.FontColor="#DC3030FF" ClipContents="false">
                            <Children>
                              <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="12" SuggestedHeight="16" PositionXOffset="15" VerticalAlignment="Center" HorizontalAlignment="Right" Sprite="General\CharacterCreation\increasing_icon" Color="#DC3030FF" ScaleToFit="true" VerticalFlip="true" />
                            </Children>
                          </TextWidget>
                        </Children>
                      </ListPanel>
                    </ItemTemplate>
                  </ListPanel>

                  <!-- Skills List -->
                  <ListPanel DataSource="{Skills}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="HorizontalLeftToRight">
                    <ItemTemplate>
                      <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginLeft="5" MarginRight="5" StackLayout.LayoutMethod="VerticalBottomToTop">
                        <Children>
                          <SkillIconVisualWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="61" SuggestedHeight="61" SkillId="@SkillId" UseSmallVariation="true" />

                          <!-- Focus Change Indicator -->
                          <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="63" SuggestedHeight="28" MarginTop="5">
                            <Children>
                              <!-- Positive Change (Green) -->
                              <Widget IsVisible="@IsPositive" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="General\CharacterCreation\focus_amount_frame" Color="#3A6E24FF">
                                <Children>
                                  <TextWidget Text="@FocusChangeText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush.FontSize="20" Brush.FontColor="#99DC30FF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" />
                                  <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="9" SuggestedHeight="13" Sprite="General\CharacterCreation\increasing_icon" Color="#99DC30FF" MarginLeft="5" VerticalAlignment="Center" />
                                </Children>
                              </Widget>
                              <!-- Negative Change (Red) -->
                              <Widget IsVisible="@IsNegative" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="General\CharacterCreation\focus_amount_frame" Color="#6E2424FF">
                                <Children>
                                  <TextWidget Text="@FocusChangeText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush.FontSize="20" Brush.FontColor="#DC3030FF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" />
                                  <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="9" SuggestedHeight="13" Sprite="General\CharacterCreation\increasing_icon" Color="#DC3030FF" MarginLeft="5" VerticalAlignment="Center" VerticalFlip="true" />
                                </Children>
                              </Widget>
                            </Children>
                          </ListPanel>
                        </Children>
                      </ListPanel>
                    </ItemTemplate>
                  </ListPanel>

                </Children>
              </ListPanel>
            </Children>
          </Widget>

          <!-- Main content panel - POSITIONED ON RIGHT to show character on left -->

        <!-- Main content panel - Character Creation Style -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="694" SuggestedHeight="1080"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Sprite="General\CharacterCreation\character_creation_panel"
                DoNotUseCustomScaleAndChildren="true">
          <Children>

            <!-- Title -->
            <TextWidget Text="@TitleText"
                        WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="670" SuggestedHeight="55"
                        HorizontalAlignment="Right"
                        Brush="Stage.Title.Text" />

            <!-- Inner Panel Container (like native character creation) -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                    SuggestedWidth="573" SuggestedHeight="750"
                    MarginTop="70" MarginLeft="50"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Children>

            <!-- Description (fixed at top) -->
            <TextWidget Text="@DescriptionText"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                        MarginTop="25" MarginLeft="20" MarginRight="20"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Brush="Stage.Description.Text"
                        ClipContents="false" />

            <!-- Options List - Scrollable section for choices only (shows ~4-5 items) -->
            <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                             SuggestedHeight="320"
                             AutoHideScrollBars="true"
                             MarginTop="140" MarginLeft="20" MarginRight="45"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             ClipRect="OptionsClipRect"
                             InnerPanel="OptionsClipRect\OptionsList"
                             VerticalScrollbar="..\OptionsScrollbar">
              <Children>

                <Widget Id="OptionsClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        ClipContents="true">
                  <Children>

                    <ListPanel Id="OptionsList" DataSource="{Options}"
                               WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               StackLayout.LayoutMethod="VerticalBottomToTop">
                      <ItemTemplate>
                        <ButtonWidget DoNotPassEventsToChildren="true"
                                      Command.Click="ExecuteSelect"
                                      WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                      MarginBottom="8"
                                      Brush="FaceGen.Generic.Button"
                                      IsSelected="@IsSelected"
                                      MinHeight="10"
                                      UpdateChildrenStates="true">
                          <Children>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                       MarginLeft="10" MarginRight="10" MarginTop="7" MarginBottom="7"
                                       StackLayout.LayoutMethod="HorizontalLeftToRight">
                              <Children>

                                <!-- Icon -->
                                <ImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                             SuggestedWidth="50" SuggestedHeight="50"
                                             MarginRight="15"
                                             Sprite="@IconSprite" />

                                <!-- Option name -->
                                <TextWidget DoNotAcceptEvents="true"
                                            Text="@Name"
                                            WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                            Brush="Generic.Button.Text" />

                              </Children>
                            </ListPanel>
                          </Children>
                        </ButtonWidget>
                      </ItemTemplate>
                    </ListPanel>

                  </Children>
                </Widget>

                <!-- Scroll Gradient for options -->
                <Widget DoNotAcceptEvents="true"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                        SuggestedHeight="57"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Sprite="General\CharacterCreation\character_creation_scroll_gradient" />

              </Children>
            </ScrollablePanel>

            <!-- Scrollbar for options only -->
            <ScrollbarWidget Id="OptionsScrollbar"
                             WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                             SuggestedWidth="8" SuggestedHeight="320"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             MarginTop="140" MarginRight="20"
                             AlignmentAxis="Vertical"
                             Handle="OptionsScrollbarHandle"
                             MaxValue="100" MinValue="0">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                        SuggestedWidth="4"
                        HorizontalAlignment="Center"
                        Sprite="BlankWhiteSquare_9"
                        AlphaFactor="0.2"
                        Color="#5a4033FF" />
                <ImageWidget Id="OptionsScrollbarHandle"
                             WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                             SuggestedWidth="8" SuggestedHeight="10"
                             HorizontalAlignment="Center"
                             Brush="FaceGen.Scrollbar.Handle" />
              </Children>
            </ScrollbarWidget>

            <!-- Detail Panel (fixed below options) -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                    MarginLeft="25" MarginRight="25" MarginTop="480"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    IsVisible="@HasSelection">
              <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                           StackLayout.LayoutMethod="VerticalBottomToTop">
                  <Children>

                    <!-- Description -->
                    <TextWidget Text="@SelectedDescription"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                MarginBottom="10"
                                Brush="Stage.Selection.Description.Text" />

                    <!-- Positive Effect -->
                    <RichTextWidget Text="@SelectedPositiveEffect"
                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                    MarginBottom="10"
                                    Brush="Stage.PositiveEffect.Text"
                                    IsVisible="@HasPositiveEffect" />

                    <!-- Negative Effect -->
                    <RichTextWidget Text="@SelectedNegativeEffect"
                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                    MarginBottom="10"
                                    Brush="Stage.NegativeEffect.Text"
                                    IsVisible="@HasNegativeEffect" />

                  </Children>
                </ListPanel>
              </Children>
            </Widget>

              </Children>
            </Widget>

            <!-- Previous and Next Buttons -->
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       MarginBottom="50" MarginRight="40">
              <Children>

                <!-- Back Button -->
                <ButtonWidget DoNotPassEventsToChildren="true"
                              Command.Click="OnPreviousStage"
                              WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="125" SuggestedHeight="64"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              MarginRight="20"
                              Brush="Standard.BackButton"
                              UpdateChildrenStates="true" />

                <!-- Continue Button -->
                <ButtonWidget DoNotPassEventsToChildren="true"
                              Command.Click="OnNextStage"
                              IsEnabled="@CanAdvance"
                              WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="400" SuggestedHeight="64"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              MarginLeft="20"
                              Brush="Popup.Done.Button.NineGrid"
                              UpdateChildrenStates="true">
                  <Children>
                    <TextWidget DoNotAcceptEvents="true"
                                Text="@AffirmativeText"
                                WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Brush="Popup.Button.Text" />
                  </Children>
                </ButtonWidget>

              </Children>
            </ListPanel>

          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
