<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

          <!-- Standard Background -->


          <!-- Character Display on Left (using CharacterTableauWidget like SpellBook) -->
          <CharacterTableauWidget DataSource="{CurrentCharacter}"
                                  WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                  SuggestedWidth="550" SuggestedHeight="1000"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  MarginLeft="100"
                                  BannerCodeText="@BannerCodeText"
                                  BodyProperties="@BodyProperties"
                                  CharStringId="@CharStringId"
                                  EquipmentCode="@EquipmentCode"
                                  IsFemale="@IsFemale"
                                  MountCreationKey="@MountCreationKey"
                                  Race="@Race"
                                  StanceIndex="@StanceIndex"
                                  ArmorColor1="@ArmorColor1"
                                  ArmorColor2="@ArmorColor2"
                                  IsEnabled="false"
                                  DoNotUseCustomScale="true" />

          <!-- Main content panel - POSITIONED ON RIGHT to show character on left -->

        <!-- Main content panel - MOVED TO RIGHT to show character on left -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="900" SuggestedHeight="700"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                MarginRight="50"
                Sprite="StdAssets\Popup\canvas">
          <Children>

            <!-- Title -->
            <RichTextWidget Text="@TitleText"
                            WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                            SuggestedWidth="800"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            MarginTop="50"
                            Brush.FontSize="42"
                            Brush.TextHorizontalAlignment="Center"
                            Brush.Color="#FFFFFFFF" />

            <!-- Description -->
            <RichTextWidget Text="@DescriptionText"
                            WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
                            SuggestedWidth="750"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            MarginTop="150"
                            Brush.FontSize="28"
                            Brush.TextHorizontalAlignment="Center"
                            Brush.Color="#FFFFFFFF" />

            <!-- Options List -->
            <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                       SuggestedWidth="800" SuggestedHeight="350"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       MarginTop="80"
                       DataSource="{Options}"
                       StackLayout.LayoutMethod="VerticalBottomToTop">
              <ItemTemplate>
                <ButtonWidget DoNotPassEventsToChildren="true"
                              Command.Click="ExecuteSelect"
                              WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="780" SuggestedHeight="65"
                              MarginBottom="5"
                              Sprite="StdAssets\Popup\buttonbase2">
                  <Children>
                    <!-- Selection indicator (shown when selected) -->
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                            SuggestedWidth="50" SuggestedHeight="50"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            MarginLeft="10"
                            Sprite="BlankWhiteSquare_9"
                            Color="#FFD700"
                            IsVisible="@IsSelected" />

                    <!-- Option name and description container -->
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                            SuggestedWidth="700"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            MarginLeft="70">
                      <Children>
                        <!-- Option name -->
                        <TextWidget DoNotAcceptEvents="true"
                                    Text="@Name"
                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    MarginTop="5"
                                    Brush.FontSize="32"
                                    Brush.Color="#FFFFFFFF" />

                        <!-- Option description -->
                        <TextWidget DoNotAcceptEvents="true"
                                    Text="@Description"
                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    MarginTop="35"
                                    Brush.FontSize="20"
                                    Brush.Color="#CCCCCCCC" />
                      </Children>
                    </Widget>

                    <!-- Effects container (right side of button) -->
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                            SuggestedWidth="150"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            MarginRight="10">
                      <Children>
                        <!-- Positive effect (green) -->
                        <TextWidget DoNotAcceptEvents="true"
                                    Text="@PositiveEffect"
                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    MarginTop="5"
                                    Brush.FontSize="18"
                                    Brush.TextHorizontalAlignment="Right"
                                    Brush.Color="#00FF00"
                                    IsVisible="@HasPositiveEffect" />

                        <!-- Negative effect (red) -->
                        <TextWidget DoNotAcceptEvents="true"
                                    Text="@NegativeEffect"
                                    WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    MarginBottom="5"
                                    Brush.FontSize="18"
                                    Brush.TextHorizontalAlignment="Right"
                                    Brush.Color="#FF0000"
                                    IsVisible="@HasNegativeEffect" />
                      </Children>
                    </Widget>

                  </Children>
                </ButtonWidget>
              </ItemTemplate>
            </ListPanel>

            <!-- Button container -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                    SuggestedWidth="600" SuggestedHeight="80"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    MarginBottom="80">
              <Children>

                <!-- Back Button -->
                <ButtonWidget DoNotPassEventsToChildren="true"
                              Command.Click="OnPreviousStage"
                              WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="250" SuggestedHeight="60"
                              HorizontalAlignment="Left"
                              Sprite="StdAssets\Popup\buttonbase2">
                  <Children>
                    <TextWidget DoNotAcceptEvents="true"
                                Text="@NegativeText"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Brush.FontSize="28"
                                Brush.TextHorizontalAlignment="Center"
                                Brush.TextVerticalAlignment="Center"
                                Brush.Color="#FFFFFFFF" />
                  </Children>
                </ButtonWidget>

                <!-- Continue Button -->
                <ButtonWidget DoNotPassEventsToChildren="true"
                              Command.Click="OnNextStage"
                              IsEnabled="@CanAdvance"
                              WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="250" SuggestedHeight="60"
                              HorizontalAlignment="Right"
                              Sprite="StdAssets\Popup\buttonbase1">
                  <Children>
                    <TextWidget DoNotAcceptEvents="true"
                                Text="@AffirmativeText"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                Brush.FontSize="28"
                                Brush.TextHorizontalAlignment="Center"
                                Brush.TextVerticalAlignment="Center"
                                Brush.Color="#FFFFFFFF" />
                  </Children>
                </ButtonWidget>

              </Children>
            </Widget>

          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
