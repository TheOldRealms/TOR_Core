<Prefab>
  <Window>
    <!-- Waaagh Meter - Vertical bar with 4 level icons -->
    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
            SuggestedWidth="50" SuggestedHeight="350"
            HorizontalAlignment="Right" VerticalAlignment="Center"
            MarginRight="15"
            IsVisible="@IsVisible">
      <Children>
        <!-- Background -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                SuggestedWidth="20" HorizontalAlignment="Center"
                Sprite="BlankWhiteSquare_9" Color="#1A1A1AFF" />

        <!-- Progress Fill (red, from bottom) -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="20" SuggestedHeight="@FillHeight"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Sprite="BlankWhiteSquare_9" Color="#FF0000FF" />

        <!-- Level Icons (4 icons placed at level thresholds) with hover tooltips -->
        <!-- Level 0 icon: Bottom (0%) - Internal Fightin' -->
        <HintWidget DataSource="{Level0Hint}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="32"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="-5"
                Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="shyish" />
          </Children>
        </HintWidget>

        <!-- Level 1 icon: ~33% - Petty Squabblin' -->
        <HintWidget DataSource="{Level1Hint}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="32"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="100"
                Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="ghur" />
          </Children>
        </HintWidget>

        <!-- Level 2 icon: ~66% - 'Ere We Go! -->
        <HintWidget DataSource="{Level2Hint}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="32"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="217"
                Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="chamon" />
          </Children>
        </HintWidget>

        <!-- Level 3 icon: Top (100%) - WAAAGH!!!! -->
        <HintWidget DataSource="{Level3Hint}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="32"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="323"
                Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="aqshy" />
          </Children>
        </HintWidget>

        <!-- Border -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                SuggestedWidth="20" HorizontalAlignment="Center"
                Sprite="BlankWhiteSquare_9" Color="#50463C44" />
      </Children>
    </Widget>
  </Window>
</Prefab>