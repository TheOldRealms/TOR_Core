<Prefab>
  <Window>
    <!-- Waaagh Meter - Vertical bar with 4 level icons -->
    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
            SuggestedWidth="80" SuggestedHeight="350"
            HorizontalAlignment="Right" VerticalAlignment="Center"
            MarginRight="5"
            IsVisible="@IsVisible">
      <Children>
        <!-- Background -->
        <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                SuggestedWidth="20" HorizontalAlignment="Center"
                Sprite="BlankWhiteSquare_9" Color="#1A1A1AFF" />

        <!-- Progress Fill (red, from bottom) -->
        <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="20" SuggestedHeight="@FillHeight"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Sprite="BlankWhiteSquare_9" Color="#FF0000FF" />

        <!-- Level Icons (4 icons placed at level thresholds) with hover tooltips -->
        <!-- Level 0 icon: Bottom (0%) - Internal Fightin' -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="48" SuggestedHeight="48"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="-13"
                Sprite="BlankWhiteSquare_9" Color="#00000040">
          <Children>
            <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Sprite="shyish" />
            <HintWidget DataSource="{Level0Hint}" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
          </Children>
        </Widget>

        <!-- Level 1 icon: ~33% - Petty Squabblin' -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="48" SuggestedHeight="48"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="92"
                Sprite="BlankWhiteSquare_9" Color="#00000040">
          <Children>
            <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Sprite="ghur" />
            <HintWidget DataSource="{Level1Hint}" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
          </Children>
        </Widget>

        <!-- Level 2 icon: ~66% - 'Ere We Go! -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="48" SuggestedHeight="48"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="209"
                Sprite="BlankWhiteSquare_9" Color="#00000040">
          <Children>
            <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Sprite="chamon" />
            <HintWidget DataSource="{Level2Hint}" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
          </Children>
        </Widget>

        <!-- Level 3 icon: Top (100%) - WAAAGH!!!! -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="48" SuggestedHeight="48"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="315"
                Sprite="BlankWhiteSquare_9" Color="#00000040">
          <Children>
            <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Sprite="aqshy" />
            <HintWidget DataSource="{Level3Hint}" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
          </Children>
        </Widget>

        <!-- Border -->
        <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                SuggestedWidth="20" HorizontalAlignment="Center"
                Sprite="BlankWhiteSquare_9" Color="#50463C44" />
      </Children>
    </Widget>
  </Window>
</Prefab>