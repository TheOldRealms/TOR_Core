<?xml version="1.0"?>
<ArrayOfSpecializationOption xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<!--
	Specialization options for Stage 4 of character creation
	Simplified structure matching cc_options.xml format

	ProfessionRequirement values:
		- option_3_empire_magister_apprentice (Spellcasters)
		- option_3_vc_vampire / option_3_mousillon_vampire (Vampires)
		- option_3_empire_priest_acolyte (Priests)
		- option_3_empire_knight (Knights)
	-->

