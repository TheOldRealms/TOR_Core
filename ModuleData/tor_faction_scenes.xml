<?xml version="1.0" encoding="utf-8"?>
<!--
  TOR faction-scene registry. Read on campaign start by TORFactionSceneRegistry.Load().
  Each <Scene> row overrides a vanilla SceneNotificationItem's SceneID when its filters match.
  No entry matches = vanilla scene plays unchanged. See TORTasks/faction-scenes-registry/ for the design.

  Supported triggers (one Harmony patch per trigger, add more as needed):
    FactionJoin   — JoinKingdomSceneNotificationItem

  TOR shadows vanilla culture ids (verified against tor_cultures.xml):
    khuzait  = Vampire Counts
    vlandia  = Bretonnia
    battania = Wood Elves
-->
<FactionScenes>
  <Scene id="bretonnia_factionjoin"
         trigger="FactionJoin"
         culture="vlandia"
         scene_id="TOR_cutscene_factionjoin_bretonnia_01" />

  <Scene id="vc_factionjoin"
         trigger="FactionJoin"
         culture="khuzait"
         scene_id="TOR_cutscene_factionjoin_VC_01" />

  <Scene id="woodelf_factionjoin"
         trigger="FactionJoin"
         culture="battania"
         scene_id="TOR_cutscene_factionjoin_we_01" />
</FactionScenes>
